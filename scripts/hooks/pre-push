#!/usr/bin/env bash
# Template for .git/hooks/pre-push -- git hooks are never cloned or synced,
# so this has to be copied into place by hand on each dev machine (see
# AGENTS.md's "PII / privacy" section for the one-time install step):
#
#   cp scripts/hooks/pre-push .git/hooks/pre-push
#   chmod +x .git/hooks/pre-push
#
# Blocks a push if scripts/check-pii.sh finds anything in the commits being
# pushed. This is the mechanical backstop: it fires on every push -- one run
# directly by a human, not just one an AI assistant remembers to check
# first -- which is the whole point of it existing rather than relying on
# memory/discipline alone.
#
# Git passes push info on stdin, one line per ref being pushed:
#   <local ref> <local sha1> <remote ref> <remote sha1>
#
# Read it via a `while read ... <&3` loop against a saved copy of stdin
# (fd 3), not a plain `while read ...; do ... done < /dev/stdin` reading fd 0
# directly -- a command invoked inside such a loop's body can steal input
# meant for the loop itself if it ever touches stdin. None of what's called
# below should, but this sidesteps the whole class of bug. (`mapfile` would
# be the more obvious fix but is Bash 4+ only -- macOS's own /bin/bash,
# which is what actually runs this hook on a stock Mac, is the ancient 3.2,
# confirmed by hand while writing this: `mapfile: command not found`.)

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
ZERO="0000000000000000000000000000000000000000"
FAILED=0

# Not ref-specific, so run once up front rather than once per ref in the loop
# below. pytest is dev-only tooling (requirements-dev.txt) -- if it's not
# installed, warn and let the push through rather than blocking on tooling
# absence; a failing suite, once installed, does block.
#
# Run under `coverage`, not a bare pytest, when coverage is installed: CI's
# gate is `.coveragerc`'s fail_under, and until this ran under coverage too,
# that gate existed only in CI -- a change that dropped coverage below the
# floor passed every local check and only failed on the PR. Same
# WARN-if-missing/FAIL-if-failing split as pytest/ruff below: coverage is
# dev-only tooling, so its absence here is expected on a checkout that
# hasn't run the one-time `pip install -r requirements-dev.txt` setup.
#
# Run in a `cd`-ed subshell, not via --rcfile from the caller's cwd:
# .coveragerc's `source = app / discovery / probes` are resolved relative to
# the CURRENT WORKING DIRECTORY, not to the rcfile's location (unlike
# ruff's --cache-dir, which does take an absolute path directly) -- a git
# hook's invoking cwd isn't guaranteed to be the repo root, so this matches
# what CI's `coverage run -m pytest -q` gets for free by running from the
# checkout root.
if [ -x "$REPO_DIR/.venv/bin/coverage" ]; then
  if [ -x "$REPO_DIR/.venv/bin/pytest" ]; then
    if ! (cd "$REPO_DIR" && "$REPO_DIR/.venv/bin/coverage" run -m pytest -q); then
      echo "" >&2
      echo "pre-push: pytest suite failed -- push blocked." >&2
      FAILED=1
    elif ! (cd "$REPO_DIR" && "$REPO_DIR/.venv/bin/coverage" report); then
      echo "" >&2
      echo "pre-push: coverage dropped below the .coveragerc fail_under threshold -- push blocked." >&2
      FAILED=1
    fi
  else
    echo "pre-push: pytest not installed in .venv -- skipping test run (run: pip install -r requirements-dev.txt)" >&2
  fi
elif [ -x "$REPO_DIR/.venv/bin/pytest" ]; then
  if ! "$REPO_DIR/.venv/bin/pytest" -q "$REPO_DIR"; then
    echo "" >&2
    echo "pre-push: pytest suite failed -- push blocked." >&2
    FAILED=1
  fi
  echo "pre-push: coverage not installed in .venv -- ran pytest without the coverage gate (run: pip install -r requirements-dev.txt)" >&2
else
  echo "pre-push: pytest not installed in .venv -- skipping test run (run: pip install -r requirements-dev.txt)" >&2
fi

# Same reasoning as the pytest block above: not ref-specific, so run once
# up front. ruff is dev-only tooling (requirements-dev.txt) -- missing is a
# WARN, a real lint failure (once installed) is a FAIL that blocks the push.
# --cache-dir is explicit, not left to default relative-to-cwd behaviour --
# confirmed empirically that an absolute-path invocation from an unexpected
# cwd otherwise errors trying to create the cache next to cwd, not the repo.
if [ -x "$REPO_DIR/.venv/bin/ruff" ]; then
  if ! "$REPO_DIR/.venv/bin/ruff" check "$REPO_DIR" --cache-dir "$REPO_DIR/.ruff_cache"; then
    echo "" >&2
    echo "pre-push: ruff check failed -- push blocked." >&2
    FAILED=1
  fi
else
  echo "pre-push: ruff not installed in .venv -- skipping lint (run: pip install -r requirements-dev.txt)" >&2
fi

exec 3<&0

while read -r local_ref local_sha remote_ref remote_sha <&3; do
  [ "$local_sha" = "$ZERO" ] && continue  # a branch/tag deletion -- nothing to check

  if [ "$remote_sha" = "$ZERO" ]; then
    # Remote ref doesn't exist yet (new branch) -- nothing to diff against,
    # so check everything reachable from the local commit. git rev-list
    # accepts a single revision the same way it accepts a two-dot range, so
    # scripts/check-pii.sh's --range argument works unchanged either way.
    RANGE="$local_sha"
  else
    RANGE="$remote_sha..$local_sha"
  fi

  if ! "$REPO_DIR/scripts/check-pii.sh" --range "$RANGE"; then
    FAILED=1
  fi
done
exec 3<&-

if [ "$FAILED" -ne 0 ]; then
  {
    echo ""
    echo "pre-push: a check above failed (pytest, ruff, and/or check-pii.sh) -- push blocked."
    echo "Fix it, or if you're certain it's a false positive:"
    echo "  git push --no-verify"
    echo "(only do that deliberately -- see AGENTS.md's \"PII / privacy\" section)"
  } >&2
  exit 1
fi

exit 0
