# Caddy reverse proxy for the app -- the LAN-facing alternative to Tailscale
# Serve (README, "Reaching it over HTTPS"). Copy to /opt/homebrew/etc/Caddyfile
# and `brew services start caddy`. Caddy runs as your user, not root.
#
# Replace assets.home with the name your LAN resolves to this Mac (a static
# DNS entry on the router, or /etc/hosts on each client), and list the same
# name in APP_ALLOWED_HOSTS in .env. `tls internal` issues a certificate from
# Caddy's own local CA; trust that CA once per client device (`caddy trust`
# on the Mini prints where the root certificate lives) or browsers will warn.
#
# Caddy sets X-Forwarded-For / X-Forwarded-Proto on its own; uvicorn trusts
# them only from 127.0.0.1 (see scripts/com.assetmgt.app.plist).

assets.home {
	tls internal
	reverse_proxy 127.0.0.1:8000
}

# Plain http on the LAN stays closed: nothing listens on :80 for the app, and
# the app itself only listens on loopback.
