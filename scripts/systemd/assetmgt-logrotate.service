# systemd equivalent of scripts/com.assetmgt.logrotate.plist.
[Unit]
Description=Bound the app's log files (copy-then-truncate)

[Service]
Type=oneshot
User=__ASSETMGT_USER__
WorkingDirectory=__ASSETMGT_DIR__
ExecStart=/bin/bash __ASSETMGT_DIR__/scripts/rotate-logs.sh
StandardError=append:__ASSETMGT_DIR__/logs/rotate.error.log
