# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://assetmgt:assetmgt@localhost:5432/assetmgt

# App auth (HTTP Basic in front of the whole dashboard/API). REQUIRED: the
# app refuses to start if APP_ADMIN_PASSWORD is left unset or as this literal
# placeholder -- an empty expected password would mean any password matches.
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=change-me

# Root log level for the app and discovery CLI (see app/logging_config.py).
# Optional -- defaults to INFO in code. Set DEBUG to surface httpx/app detail
# and the per-seed probe misses; WARNING to quieten routine access logs.
# Logs go to stdout/stderr, which launchd captures into logs/app.log and
# logs/app.error.log (WARNING+); nothing here writes a log file directly.
LOG_LEVEL=INFO

# UniFi Network application (local controller or UDM/Cloud Gateway console)
UNIFI_BASE_URL=https://192.168.1.1
UNIFI_API_KEY=
UNIFI_SITE=default
# TLS certificate verification for the UniFi API. Defaults to on (leave unset or
# "true"). Set to "false" ONLY for a self-signed UDM/controller you trust on your
# own LAN -- it disables MITM protection for the API key.
UNIFI_VERIFY_TLS=true

# Home network ranges to scan (comma-separated CIDRs)
SCAN_SUBNETS=192.168.1.0/24

# NVD API key is optional but raises the rate limit substantially
NVD_API_KEY=

# Optional: powers the per-asset "investigation assistant" chat panel. If
# unset, the chat panel just shows a "not configured" note -- everything
# else in the app works fine without it. Get a key from
# https://console.anthropic.com/. ANTHROPIC_MODEL defaults to claude-opus-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Fallback credential for the investigation assistant, used only when
# ANTHROPIC_API_KEY above is unset. Routes the same Claude calls through
# OpenRouter's Anthropic-compatible endpoint instead of api.anthropic.com --
# get a key from https://openrouter.ai/keys. ANTHROPIC_MODEL still applies.
OPENROUTER_API_KEY=

# Default owner assigned to newly discovered assets. Optionally, a second
# household member can be auto-assigned by a keyword match in the device's
# hostname (e.g. if their devices are named with their name in them) --
# leave both SECONDARY_ fields blank to skip that and always use DEFAULT_OWNER.
DEFAULT_OWNER=Owner
SECONDARY_OWNER_NAME=
SECONDARY_OWNER_HOSTNAME_KEYWORD=

# Nightly off-site database backup (scripts/backup-db.sh, see README's
# "Off-site database backups"). These belong to an existing, full-S3-access
# IAM identity by deliberate choice -- not a dedicated least-privilege one --
# so backup history is protected by S3 Object Lock (set on the bucket itself)
# rather than by an IAM policy with no delete permission.
BACKUP_S3_BUCKET=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_REGION=

# NOT read from here: BACKUP_KEEP_LOCAL (local dump retention count) is a
# backup-db.sh shell variable read from the *process* environment, not this
# file -- under launchd that's just PATH (see com.assetmgt.backup.plist), so
# setting it in .env is a silent no-op. Override it in the plist itself if
# you ever need to.
